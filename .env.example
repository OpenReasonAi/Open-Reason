# Public addresses from wallets you control. Keep the wallets offline or hardware-backed.
OREN_LAUNCH_OWNER=
OREN_TREASURY_OWNER=
# Verified token contract from the confirmed launch receipt. Leave empty before launch.
OREN_TOKEN_ADDRESS=
BASE_RPC_URL=https://mainnet.base.org
# Launchpad key from the developer portal. Store scoped keys only on the operator machine.
O1_API_KEY=
# Owner-selected transaction caps. Raw amounts are wei.
OREN_MAX_LAUNCH_FEE_WEI=
OREN_MAX_BUYBACK_WEI=
OREN_MAX_SLIPPAGE_BPS=
OREN_MAX_NETWORK_FEE_WEI=
